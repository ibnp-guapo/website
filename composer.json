{
  "name": "ibnp-guapo/website",
  "description": "Website oficial da Igreja Batista Nacional da Paz de Guapó (IBNP Guapó)",
  "type": "project",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.2",
    "ext-dom": "*",
    "ext-xml": "*",
    "jenssegers/blade": "^2.0",
    "bramus/router": "~1.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "test": "phpunit",
    "serve": "php -S 0.0.0.0:8000 -t public"
  }
}
