{
  "name": "ibnp-guapo-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website institucional da Igreja Batista Nacional da Paz de Guapó",
  "scripts": {
    "dev:css": "tailwindcss -i ./public/assets/css/input.css -o ./public/assets/css/app.css --watch",
    "build:css": "tailwindcss -i ./public/assets/css/input.css -o ./public/assets/css/app.css --minify",
    "audit:a11y": "node scripts/audit_accessibility.js",
    "test": "npm run audit:a11y"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
